# Copy to .env and fill in. .env is gitignored.

# Optional override of the provider binary
# PROVIDER=/root/.local/share/urnetwork-provider/bin/urnetwork

# Bittensor hotkey seed (32-byte sr25519, raw or 64 hex). Required for ./run.sh all
HOTKEY_SEED_FILE=.secrets/hotkey.seed

# Payout coldkey (ss58, starts with 5). Used by ./run.sh wallet-set
# COLDKEY_SS58=5…
# COLDKEY_SEED_FILE=.secrets/coldkey.seed

# Soft memory cap for provide / --all-operators (split across operators)
# MAX_MEMORY=512mib

# Status HTTP port (0 = disabled)
# PORT=0

# Optional operators list URL (default https://ur.xyz/operators.yml)
# OPERATORS_URL=

# Miner state directory (default ~/.urnetwork)
# URNETWORK_STATE_DIR=

# PM2 process names
# PM2_NAME=sn25-miner
# PM2_NAME_ALL=sn25-miner-all

# When starting under PM2 and nothing is running yet, stop the installer
# service / other owners so the credential has a single owner (1=yes).
# SN25_TAKEOVER=1
